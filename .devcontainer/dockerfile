FROM ghcr.io/cpdevtools/dcm-images-devcontainers/angular-dotnet-edge-dc-image:next

# Tooling that has to survive a rebuild keeps its files in .data (on the mounted volume); the image
# only installs programs and links the paths the tools expect to there.

# The system libraries Chromium needs, for the Playwright MCP server (its browsers are in
# .data/ms-playwright). Debian 11's security updates moved to archive.debian.org when its LTS ended
# (August 2026).
USER root
RUN sed -i 's#^deb http://deb.debian.org/debian-security bullseye-security#deb http://archive.debian.org/debian-security bullseye-security#' /etc/apt/sources.list \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && npx -y playwright@1.56.1 install-deps chromium \
 && rm -rf /var/lib/apt/lists/*

# uv, for heroes-capture's Python environment.
RUN curl -LsSf https://astral.sh/uv/0.13.1/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh

# uv's Pythons (heroes-capture's .venv links into them), uv's package cache, heroes-capture's game
# data downloads and Playwright's browsers.
RUN mkdir -p /home/node/.local/share /home/node/.cache \
 && ln -s /devcontainer/.devcontainer/.data/uv /home/node/.local/share/uv \
 && ln -s /devcontainer/.devcontainer/.data/uv-cache /home/node/.cache/uv \
 && ln -s /devcontainer/.devcontainer/.data/heroes-capture /home/node/.cache/heroes-capture \
 && ln -s /devcontainer/.devcontainer/.data/ms-playwright /home/node/.cache/ms-playwright \
 && chown -R node:node /home/node/.local /home/node/.cache
USER node

# Language servers for Claude Code's LSP plugins (typescript-lsp, pyright-lsp). A project's own
# node_modules/typescript wins over the global one.
RUN npm i -g typescript-language-server@6.0.1 typescript@6.0.3 pyright@1.1.414
